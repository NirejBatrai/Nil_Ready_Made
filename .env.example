# Copy to .env for local development. Never commit .env.
# These are SERVER-ONLY settings: never prefix them with VITE_ (VITE_* values are sent to the browser).
# In production (Node server: `node .output/server/index.mjs`), set them in the host's environment or
# secret store. The server also reads HOST and PORT; set HOST (e.g. 127.0.0.1 behind a reverse
# proxy), otherwise it listens on all interfaces.

# MongoDB Atlas connection string. Use a NON-production database during development.
MONGODB_URI=

# Optional: "true" enables the database health-check diagnostic outside `vite dev`.
DB_HEALTHCHECK_ENABLED=

# Optional: HSTS max-age in whole seconds (1 to 63072000). Leave EMPTY until HTTPS on the real
# domain is verified; it is only sent by production builds on https requests. Start with 300.
SECURITY_HSTS_MAX_AGE=

# INTERIM Quick Sales (decision 0004): bearer token for GET /api/daily-summary (used by n8n later).
# At least 32 characters, or the API refuses every request. Generate one with:
#   openssl rand -base64 32
# Set it only in the host's environment (Vercel: Production only, Sensitive). Never commit a real token.
SUMMARY_API_TOKEN=
