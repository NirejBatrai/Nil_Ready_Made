# Copy to .env for local development. Never commit .env.
# These are SERVER-ONLY settings: never prefix them with VITE_ (VITE_* values are sent to the browser).
# In production, set them as Cloudflare Worker secrets (`wrangler secret put MONGODB_URI`).

# MongoDB Atlas connection string. Use a NON-production database during development.
MONGODB_URI=

# Optional: "true" enables the database health-check diagnostic outside `vite dev`.
DB_HEALTHCHECK_ENABLED=
